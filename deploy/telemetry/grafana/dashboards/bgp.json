{
  "uid": "clab-bgp",
  "title": "BGP neighbours",
  "description": "BGP neighbour session state and prefix counts where the node exposes the OpenConfig BGP model over gNMI. One address family per neighbour is charted.",
  "tags": [
    "containerlab",
    "node-manager"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "lab",
        "label": "Lab",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clab-prometheus"
        },
        "definition": "label_values(clab_telemetry_node_state, lab)",
        "query": {
          "qryType": 1,
          "query": "label_values(clab_telemetry_node_state, lab)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clab-prometheus"
        },
        "definition": "label_values(clab_telemetry_node_state{lab=\"$lab\"}, node)",
        "query": {
          "qryType": 1,
          "query": "label_values(clab_telemetry_node_state{lab=\"$lab\"}, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Lab overview",
      "type": "link",
      "url": "/d/clab-lab-overview",
      "keepTime": true,
      "includeVars": true,
      "icon": "dashboard",
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "title": "Interfaces",
      "type": "link",
      "url": "/d/clab-interface",
      "keepTime": true,
      "includeVars": true,
      "icon": "dashboard",
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Neighbours now",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_bgp_neighbor_state{lab=\"$lab\", node=~\"$node\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "lab_id": true,
              "lab": true,
              "container": true,
              "platform": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Session established",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_bgp_neighbor_established{lab=\"$lab\", node=~\"$node\"}",
          "legendFormat": "{{node}} → {{neighbor}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ESTABLISHED",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "not established",
                  "color": "orange",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Prefixes received",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_bgp_neighbor_prefixes_received{lab=\"$lab\", node=~\"$node\"}",
          "legendFormat": "{{node}} ← {{neighbor}} ({{afi}})",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Prefixes sent",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_bgp_neighbor_prefixes_sent{lab=\"$lab\", node=~\"$node\"}",
          "legendFormat": "{{node}} → {{neighbor}} ({{afi}})",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}

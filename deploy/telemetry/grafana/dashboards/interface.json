{
  "uid": "clab-interface",
  "title": "Interfaces",
  "description": "Interface rates and state per node and port. Rates are derived by the manager from counter deltas sampled every 10 s; a reset or a gap produces no rate.",
  "tags": [
    "containerlab",
    "node-manager"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "quick_ranges": [
      {"display": "Last 5 minutes", "from": "now-5m", "to": "now"},
      {"display": "Last 15 minutes", "from": "now-15m", "to": "now"}
    ]
  },
  "templating": {
    "list": [
      {
        "name": "lab",
        "label": "Lab",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clab-prometheus"
        },
        "definition": "label_values(clab_telemetry_node_state, lab)",
        "query": {
          "qryType": 1,
          "query": "label_values(clab_telemetry_node_state, lab)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clab-prometheus"
        },
        "definition": "label_values(clab_telemetry_node_state{lab=\"$lab\"}, node)",
        "query": {
          "qryType": 1,
          "query": "label_values(clab_telemetry_node_state{lab=\"$lab\"}, node)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "hide": 0
      },
      {
        "name": "interface",
        "label": "Interface",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clab-prometheus"
        },
        "definition": "label_values(clab_interface_oper_up{lab=\"$lab\", node=~\"$node\"}, interface)",
        "query": {
          "qryType": 1,
          "query": "label_values(clab_interface_oper_up{lab=\"$lab\", node=~\"$node\"}, interface)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Lab overview",
      "type": "link",
      "url": "/d/clab-lab-overview",
      "keepTime": true,
      "includeVars": true,
      "icon": "dashboard",
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "title": "BGP",
      "type": "link",
      "url": "/d/clab-bgp",
      "keepTime": true,
      "includeVars": true,
      "icon": "dashboard",
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Bit rate",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_interface_receive_bits_per_second{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}",
          "legendFormat": "{{node}} {{interface}} RX",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_interface_transmit_bits_per_second{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}",
          "legendFormat": "{{node}} {{interface}} TX",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Packet rate",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_interface_receive_packets_per_second{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}",
          "legendFormat": "{{node}} {{interface}} RX",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_interface_transmit_packets_per_second{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}",
          "legendFormat": "{{node}} {{interface}} TX",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "pps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors and discards per second",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "rate(clab_interface_receive_errors_total{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}[1m])",
          "legendFormat": "{{node}} {{interface}} RX errors",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "rate(clab_interface_transmit_errors_total{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}[1m])",
          "legendFormat": "{{node}} {{interface}} TX errors",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "rate(clab_interface_receive_discards_total{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}[1m])",
          "legendFormat": "{{node}} {{interface}} RX discards",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "rate(clab_interface_transmit_discards_total{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}[1m])",
          "legendFormat": "{{node}} {{interface}} TX discards",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "state-timeline",
      "title": "Operational state",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_interface_oper_up{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}",
          "legendFormat": "{{node}} {{interface}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "rowHeight": 0.8,
        "mergeValues": true,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Interfaces now",
      "description": "peer and peer_interface come from the lab's topology wiring; role separates physical, management and other interfaces.",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_interface_oper_up{lab=\"$lab\", node=~\"$node\", interface=~\"$interface\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP",
                  "color": "green",
                  "index": 0
                },
                "0": {
                  "text": "DOWN",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "lab_id": true,
              "lab": true,
              "container": true,
              "platform": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    }
  ]
}

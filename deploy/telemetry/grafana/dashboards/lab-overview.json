{
  "uid": "clab-lab-overview",
  "title": "Lab overview",
  "description": "Session telemetry of one deployed lab as the Containerlab Node Manager collects it over gNMI: node states, link states, per-node traffic. The manager keeps 60 minutes in memory; Prometheus keeps 2 hours; nothing is stored on disk.",
  "tags": [
    "containerlab",
    "node-manager"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ],
    "quick_ranges": [
      {"display": "Last 5 minutes", "from": "now-5m", "to": "now"},
      {"display": "Last 15 minutes", "from": "now-15m", "to": "now"}
    ]
  },
  "templating": {
    "list": [
      {
        "name": "lab",
        "label": "Lab",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "clab-prometheus"
        },
        "definition": "label_values(clab_telemetry_node_state, lab)",
        "query": {
          "qryType": 1,
          "query": "label_values(clab_telemetry_node_state, lab)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Interfaces",
      "type": "link",
      "url": "/d/clab-interface",
      "keepTime": true,
      "includeVars": true,
      "icon": "dashboard",
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": ""
    },
    {
      "title": "BGP",
      "type": "link",
      "url": "/d/clab-bgp",
      "keepTime": true,
      "includeVars": true,
      "icon": "dashboard",
      "asDropdown": false,
      "targetBlank": false,
      "tags": [],
      "tooltip": ""
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes streaming",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "count(clab_telemetry_node_state{lab=\"$lab\", state=\"streaming\"}) or vector(0)",
          "legendFormat": "streaming",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Nodes with telemetry",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "count(clab_telemetry_node_state{lab=\"$lab\"}) or vector(0)",
          "legendFormat": "nodes",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Links up",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "count(clab_link_status{lab=\"$lab\", status=\"up\"}) or vector(0)",
          "legendFormat": "up",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "BGP sessions established",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "count(clab_bgp_neighbor_established{lab=\"$lab\"} == 1) or vector(0)",
          "legendFormat": "established",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Node telemetry state",
      "description": "Streaming means usable samples arrive. Waiting, Configuring and Connecting resolve by themselves; Failed carries its reason in the manager's Telemetry tab.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_telemetry_node_state{lab=\"$lab\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "mappings": [
            {
              "type": "value",
              "options": {
                "streaming": {
                  "color": "green",
                  "index": 0
                },
                "stale": {
                  "color": "orange",
                  "index": 1
                },
                "failed": {
                  "color": "red",
                  "index": 2
                },
                "waiting": {
                  "color": "blue",
                  "index": 3
                },
                "configuring": {
                  "color": "blue",
                  "index": 4
                },
                "connecting": {
                  "color": "blue",
                  "index": 5
                },
                "unsupported": {
                  "color": "text",
                  "index": 6
                },
                "disabled": {
                  "color": "text",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "lab_id": true,
              "lab": true,
              "container": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "table",
      "title": "Links (judged from both ends)",
      "description": "up needs both ends fresh and UP; a fresh DOWN on either end wins; up-partial means only one end is observed.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "clab_link_status{lab=\"$lab\"}",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "editorMode": "code",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "lab_id": true,
              "lab": true
            },
            "indexByName": {},
            "renameByName": {}
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Received bit rate per node (physical ports)",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "sum by (node) (clab_interface_receive_bits_per_second{lab=\"$lab\", role=\"physical\"})",
          "legendFormat": "{{node}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Transmitted bit rate per node (physical ports)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "sum by (node) (clab_interface_transmit_bits_per_second{lab=\"$lab\", role=\"physical\"})",
          "legendFormat": "{{node}}",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "bps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Errors and discards per node (per second)",
      "description": "Device counters, not measured end-to-end loss.",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "clab-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "sum by (node) (rate(clab_interface_receive_errors_total{lab=\"$lab\"}[1m]) + rate(clab_interface_transmit_errors_total{lab=\"$lab\"}[1m]))",
          "legendFormat": "{{node}} errors",
          "range": true,
          "instant": false,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "clab-prometheus"
          },
          "expr": "sum by (node) (rate(clab_interface_receive_discards_total{lab=\"$lab\"}[1m]) + rate(clab_interface_transmit_discards_total{lab=\"$lab\"}[1m]))",
          "legendFormat": "{{node}} discards",
          "range": true,
          "instant": false,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
